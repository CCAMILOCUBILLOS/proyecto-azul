# Copia este archivo con el nombre .env y completa los valores.
# El archivo .env nunca se sube a ningun repositorio.

# Clave de la API de Anthropic (cerebro)
ANTHROPIC_API_KEY=

# Clave de la API de Deepgram (oido y voz)
DEEPGRAM_API_KEY=

# Clave para entrar a la app de Azul desde tus dispositivos
AZUL_ACCESS_KEY=

# Opcionales (si no los defines, se usa el valor indicado)
# AZUL_PORT=8710
# AZUL_BRAIN_MODEL=claude-sonnet-5-5
# AZUL_BRAIN_MODEL_DEEP=claude-opus-5-5
# AZUL_MONTHLY_BUDGET_USD=50
# AZUL_BUDGET_WARNING_USD=40

# Tablero de Red Nacional en el PC de Optometría, por Tailscale (ADR 0031)
# AZUL_RED_NACIONAL_URL=https://nombre-del-pc.tailXXXX.ts.net

# WhatsApp Business de Meta (ADR 0038). Todo vacío: Azul no usa WhatsApp.
# AZUL_WHATSAPP_TOKEN=                 # token permanente de la app de Meta (secreto)
# AZUL_WHATSAPP_NUMERO_ID=             # "Phone number ID" que muestra Meta (no es el teléfono)
# AZUL_WHATSAPP_SECRETO_APP=           # "App secret" de la app de Meta (secreto)
# AZUL_WHATSAPP_TOKEN_VERIFICACION=    # una frase que tú inventas y pones igual en Meta
# AZUL_WHATSAPP_DUENO=573001234567     # tu número personal, con indicativo y sin +
# AZUL_WHATSAPP_PLANTILLA_AVISO=       # nombre de la plantilla aprobada para avisarte pasadas 24 h
# AZUL_WHATSAPP_PUERTO=8720
# AZUL_CORREO_ACTIVO=true              # Outlook clásico: buscar, leer y dejar borradores (ADR 0037)
# AZUL_CORREO_REVISAR=true             # revisar, priorizar y alertar lo urgente (ADR 0039)
# AZUL_CORREO_REVISION_MINUTOS=10
# AZUL_CORREO_REMOTO_URL=https://nombre-del-pc.tailXXXX.ts.net:8443   # ayudante de Outlook en Optometría (ADR 0040)
# AZUL_CORREO_REMOTO_CLAVE=            # la clave que muestra el ayudante (secreto)
# AZUL_CORREO_FIRMA=Camilo Cubillos     # firma de Outlook para los correos de Azul
# AZUL_ARCHIVOS_ACTIVOS=true           # editar, organizar y correr Python (ADR 0041)
