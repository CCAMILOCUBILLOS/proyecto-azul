# Copia este archivo con el nombre .env y completa los valores.
# El archivo .env nunca se sube a ningun repositorio.

# Clave de la API de Anthropic (cerebro)
ANTHROPIC_API_KEY=

# Clave de la API de Deepgram (oido y voz)
DEEPGRAM_API_KEY=

# Clave para entrar a la app de Azul desde tus dispositivos
AZUL_ACCESS_KEY=

# Opcionales (si no los defines, se usa el valor indicado)
# AZUL_PORT=8710
# AZUL_BRAIN_MODEL=claude-sonnet-5-5
# AZUL_BRAIN_MODEL_DEEP=claude-opus-5-5
# AZUL_MONTHLY_BUDGET_USD=50
# AZUL_BUDGET_WARNING_USD=40

# Tablero de Red Nacional en el PC de Optometría, por Tailscale (ADR 0031)
# AZUL_RED_NACIONAL_URL=https://nombre-del-pc.tailXXXX.ts.net
